{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Caicys297/TradingAgents-CS5351/blob/main/docs/req/req-schema.json",
  "title": "CS5351 consolidated requirements registry",
  "type": "object",
  "required": ["registry_version", "status", "schema_target", "development_contract", "requirements"],
  "additionalProperties": false,
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "schema_target": {"const": "1.0.0"},
    "development_contract": {"type": "object", "minProperties": 6},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "priority", "statement", "fit_criterion", "verification", "tradeoff", "source_code", "source_review", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(REQ-O[1-6]-[0-9]+|O[2-6]-(FR|NFR|INV)-[0-9]+|INV-O5-[0-9]+|REQ-GOV-[0-9]+)$"},
          "type": {"enum": ["functional_behavior", "invariant", "quality_attribute", "performance", "cost", "governance", "security"]},
          "priority": {"enum": ["Must", "Should", "Could", "Won't"]},
          "statement": {"type": "string", "minLength": 12},
          "fit_criterion": {"type": "string", "minLength": 12},
          "metric": {"type": "string", "minLength": 1},
          "threshold": {"type": "string", "minLength": 1},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "tradeoff": {"type": "string", "minLength": 8},
          "source_code": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "source_review": {"type": "string", "minLength": 1},
          "status": {"const": "selected_for_development"}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"enum": ["invariant", "quality_attribute", "performance", "cost", "governance", "security"]}}, "required": ["type"]},
            "then": {"required": ["metric", "threshold"]}
          }
        ]
      }
    }
  }
}
